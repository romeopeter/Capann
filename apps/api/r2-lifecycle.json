{
  "rules": [
    {
      "id": "expire-recordings-7d",
      "enabled": true,
      "conditions": { "prefix": "recordings/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 604800 }
      },
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    },
    {
      "id": "expire-owner-index-7d",
      "enabled": true,
      "conditions": { "prefix": "owners/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 604800 }
      }
    }
  ]
}
