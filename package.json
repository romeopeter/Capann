{
  "name": "capann-monorepo",
  "private": true,
  "description": "Capann: the Chrome extension (apps/extension), its Premium API (apps/api), the website (apps/website), and the code they share (packages/).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @capann/extension",
    "build:free": "npm run build:free -w @capann/extension",
    "build:premium": "npm run build:premium -w @capann/extension",
    "build:backend": "npm run build:backend -w @capann/extension",
    "watch": "npm run watch -w @capann/extension",
    "watch:free": "npm run watch:free -w @capann/extension",
    "watch:premium": "npm run watch:premium -w @capann/extension",
    "test:wiring": "npm run test:wiring -w @capann/extension",
    "test:premium": "npm run test:premium -w @capann/extension",
    "api:dev": "npm run dev -w @capann/api",
    "api:test": "npm run test:e2e -w @capann/api",
    "api:deploy": "npm run deploy -w @capann/api",
    "website:dev": "npm run dev -w @capann/website",
    "website:build": "npm run build -w @capann/website",
    "website:preview": "npm run preview -w @capann/website",
    "website:lint": "npm run lint -w @capann/website"
  }
}
