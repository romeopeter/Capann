{
  "manifest_version": 3,
  "name": "ScreenSlate — Screen Annotation Toolkit",
  "version": "1.0.0",
  "description": "Draw, point, and highlight over any tab while screen sharing — pencil, arrow pointer, highlighter, shapes, text callouts, and a laser/spotlight pointer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle ScreenSlate annotation mode (Alt+Shift+S)"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle ScreenSlate annotation mode"
    },
    "clear-annotations": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clear all annotations on this tab"
    },
    "cycle-tool": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Cycle to the next annotation tool"
    }
  },
  "minimum_chrome_version": "102"
}
